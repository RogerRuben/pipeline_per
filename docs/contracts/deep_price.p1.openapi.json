  "components": {
    "securitySchemes": {
      "portalSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ipdemo_auth",
        "description": "Existing Portal session cookie from app/server.py AUTH_COOKIE; enforce existing authentication."
      }
    },
    "schemas": {
      "PredictionRequest": {
        "type": "object",
        "properties": {
          "product_code": {
            "type": "string",
            "minLength": 1
          },
          "release_id": {
            "type": "string",
            "minLength": 1
          },
          "model_version": {
            "type": "string",
            "minLength": 1
          },
          "price_model_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "description": "Business Values keyed by stable English field_id; validated against active schema at runtime"
          },
          "model_instance_id": {
            "type": "string",
            "minLength": 1
          },
          "business_snapshot_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "price_output_signature": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "price_unit": {
            "enum": [
              "万元"
            ]
          }
        },
        "required": [
          "product_code",
          "release_id",
          "model_version",
          "price_model_sha256",
          "parameters",
          "model_instance_id",
          "business_snapshot_sha256",
          "price_output_signature"
        ],
        "additionalProperties": false
      },
      "Field": {
        "type": "object",
        "properties": {
          "field_id": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "label_zh": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "number",
              "integer",
              "enum",
              "boolean",
              "string"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "allowed_values": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "minimum": {
            "type": "number"
          },
          "maximum": {
            "type": "number"
          },
          "model_value_mapping": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "group": {
            "type": "string",
            "enum": [
              "function",
              "performance",
              "environment",
              "other"
            ]
          },
          "price_model_input": {
            "type": "boolean"
          },
          "additive_rule_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "field_id",
          "label_zh",
          "unit",
          "type",
          "required",
          "group",
          "price_model_input",
          "additive_rule_id"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "const": false
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_input",
                  "authentication_required",
                  "forbidden",
                  "not_found",
                  "unavailable",
                  "not_configured",
                  "unsupported_mixed_adjustment",
                  "version_conflict",
                  "batch_too_large",
                  "timeout",
                  "internal_error"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "success",
          "request_id",
          "error"
        ],
        "additionalProperties": false
      },
      "PredictionResponse": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "product_code": {
            "type": "string",
            "minLength": 1
          },
          "release_id": {
            "type": "string",
            "minLength": 1
          },
          "model_version": {
            "type": "string",
            "minLength": 1
          },
          "price_model_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "price_unit": {
            "type": "string",
            "enum": [
              "万元"
            ]
          },
          "success": {
            "const": true
          },
          "pricing_mode": {
            "enum": [
              "ml",
              "additive_rule"
            ]
          },
          "predicted_price_wan": {
            "type": "number"
          },
          "business_parameters": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "description": "Business Values keyed by stable English field_id; validated against active schema at runtime"
          },
          "model_instance_id": {
            "type": "string",
            "minLength": 1
          },
          "business_snapshot_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "price_output_signature": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "request_id",
          "product_code",
          "release_id",
          "model_version",
          "price_model_sha256",
          "price_unit",
          "success",
          "pricing_mode",
          "predicted_price_wan",
          "business_parameters",
          "model_instance_id",
          "business_snapshot_sha256",
          "price_output_signature"
        ],
        "additionalProperties": false
      },
      "SchemaResponse": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "product_code": {
            "type": "string",
            "minLength": 1
          },
          "release_id": {
            "type": "string",
            "minLength": 1
          },
          "model_version": {
            "type": "string",
            "minLength": 1
          },
          "price_model_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "price_unit": {
            "type": "string",
            "enum": [
              "万元"
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Field"
